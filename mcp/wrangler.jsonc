{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifact-mimicry-mcp",
  "main": "src/oauth-entry.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArtifactMimicryMCP", "ArtifactStore"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ArtifactRendererContainer"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ArtifactMimicryMCPV2"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ArtifactRendererContainerV2"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["ArtifactRendererContainerV3"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["ArtifactRendererContainerV4"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["ArtifactMimicryMCPV3"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["ArtifactRendererContainerV5"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "ArtifactMimicryMCPV3"
      },
      {
        "name": "ARTIFACT_STORE",
        "class_name": "ArtifactStore"
      },
      {
        "name": "RENDERER",
        "class_name": "ArtifactRendererContainerV5"
      }
    ]
  },
  "containers": [
    {
      "class_name": "ArtifactRendererContainerV5",
      "image": "../container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "workflows": [
    {
      "name": "artifact-mimicry-render",
      "binding": "ARTIFACT_WORKFLOW",
      "class_name": "ArtifactRenderWorkflow"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://artifact-mimicry-mcp.izeesub.workers.dev",
    "OWNER_GITHUB_IDS": "277895262"
  },
  "observability": {
    "enabled": true
  }
}
